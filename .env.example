APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=portaljob
DB_PASSWORD=portaljob_secret
DB_NAME=portaljob
DB_SSLMODE=disable

JWT_SECRET=change-this-in-production
