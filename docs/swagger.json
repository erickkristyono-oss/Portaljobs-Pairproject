  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "nama",
          "email",
          "password",
          "role"
        ],
        "properties": {
          "nama": {
            "type": "string",
            "example": "Budi"
          },
          "email": {
            "type": "string",
            "example": "budi@mail.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "secret123"
          },
          "role": {
            "type": "string",
            "enum": [
              "jobseeker",
              "company",
              "admin"
            ],
            "example": "company"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "budi@mail.com"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "required": [
          "judul",
          "lokasi"
        ],
        "properties": {
          "judul": {
            "type": "string",
            "example": "Backend Engineer"
          },
          "deskripsi": {
            "type": "string",
            "example": "Go + Postgres"
          },
          "lokasi": {
            "type": "string",
            "example": "Jakarta"
          },
          "gaji": {
            "type": "integer",
            "example": 12000000
          }
        }
      }
    }
  }
